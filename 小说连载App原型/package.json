{
  "name": "mojian-novel-studio",
  "version": "3.3.0",
  "description": "墨间，私人小说工作台",
  "main": "electron-main.js",
  "author": "ZhuYue",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.zhuyue.mojian",
    "productName": "墨间",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release{,/**}",
      "!node_modules/.cache{,/**}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "墨间"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  }
}
